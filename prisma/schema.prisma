generator client {
  provider   = "prisma-client-js"
  //output     = "../app/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH MODELS (NextAuth)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isSuperAdmin  Boolean   @default(false)
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  producerMember         ProducerMember?
  eventMembers           EventMember[]
  invitations            Invitation[]
  configuration          UserConfiguration?
  paymentMethods         PaymentMethod[]
  createdPaymentMethods  PaymentMethod[]         @relation("CreatedPaymentMethods")
  createdEvents          Event[]                 @relation("CreatedEvents")
  memberTicketAllocation MemberTicketAllocation?
  createdTicketTypes     TicketType[]            @relation("CreatedTicketTypes")
  stockMovements         TicketStockMovement[]   @relation("StockMovements")
  featuredEvents         FeaturedEvent[]         @relation("FeaturedEventCreatedBy")
}

model UserConfiguration {
  id                              String  @id @default(cuid())
  userId                          String  @unique
  eventSoldOutNotification        Boolean @default(false)
  ticketTypeSoldOutNotification   Boolean @default(false)
  eventToBeSoldOutNotification    Boolean @default(false)
  ticketTypePublishedNotification Boolean @default(false)
  user                            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_configurations")
}

// ─────────────────────────────────────────────
// PRODUCERS 
// ─────────────────────────────────────────────

model Producer {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  email           String          @unique
  phone           String?
  state           String?
  city            String?
  logo            String?
  logoPublicId    String?
  website         String?
  venueType       VenueType?
  eventCategories EventCategory[]
  createdFrom     ProducerSource  @default(WEBSITE)
  status          ProducerStatus  @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members                 ProducerMember[]
  events                  Event[]
  paymentMethods          PaymentMethod[]
  configuration           ProducerConfiguration?
  invitations             Invitation[]
  ticketPackages          TicketPackage[]
  memberTicketAllocations MemberTicketAllocation[]

  @@map("producers")
}

model ProducerMember {
  id         String           @id @default(cuid())
  userId     String           @unique // Un usuario pertenece a una sola productora
  producerId String
  role       OrganizationRole @default(SELLER)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([producerId])
  @@map("producer_members")
}

model ProducerConfiguration {
  id                    String   @id @default(cuid())
  producerId            String   @unique
  serviceCharge         Int?     @default(0)
  maxValidatorsPerEvent Int?     @default(1)
  maxInvitesPerEvent    Int?     @default(0)
  maxTicketsPerEvent    Int?     @default(0)
  producer              Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@map("producer_configurations")
}

// ─────────────────────────────────────────────
// TICKET STOCK SYSTEM
// ─────────────────────────────────────────────

model TicketPackage {
  id                  String                     @id @default(cuid())
  producerId          String
  quantity            Int
  unitPrice           Decimal                    @db.Decimal(10, 2)
  totalPrice          Decimal                    @db.Decimal(10, 2)
  status              TicketPackageStatus        @default(ACTIVE)
  paymentStatus       TicketPackagePaymentStatus @default(PENDING)
  purchasedAt         DateTime                   @default(now())
  expiresAt           DateTime?
  notes               String?
  mpPaymentId         String?
  mpDateApproved      DateTime?
  mpPaymentMethodId   String?
  mpPaymentTypeId     String?
  mpInstallments      Int?
  mpAuthorizationCode String?
  mpTransactionAmount Decimal?                   @db.Decimal(10, 2)
  mpNetReceivedAmount Decimal?                   @db.Decimal(10, 2)
  mpFeeAmount         Decimal?                   @db.Decimal(10, 2)
  mpCurrencyId        String?
  mpRawResponse       Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([producerId])
  @@map("ticket_packages")
}

model MemberTicketAllocation {
  id         String   @id @default(cuid())
  producerId String
  userId     String   @unique
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([producerId])
  @@map("member_ticket_allocations")
}

// ─────────────────────────────────────────────
// USERS INVITATIONS
// ─────────────────────────────────────────────

model Invitation {
  id         String           @id @default(cuid())
  email      String
  role       OrganizationRole @default(SELLER)
  inviterId  String
  producerId String
  token      String           @unique
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  updatedAt  DateTime         @updatedAt
  accepted   Boolean          @default(false)

  inviter  User     @relation(fields: [inviterId], references: [id])
  producer Producer @relation(fields: [producerId], references: [id])

  @@map("invitations")
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id                    String         @id @default(cuid())
  title                 String
  slug                  String         @unique
  description           String
  address               String
  state                 String?
  city                  String?
  image                    String?
  imagePublicId            String?
  thumbnailImage           String?
  thumbnailImagePublicId   String?
  featuredImage            String?
  featuredImagePublicId    String?
  dates                 String?
  startDate             DateTime?
  saleEndDate           DateTime?
  eventEndDate          DateTime?
  status                GlobalStatus
  eventType             EventType      @default(PUBLIC)
  category              EventCategory?
  legalText             String?
  restrictions          String[]
  venue                 String?
  ageRestriction        Int?
  website               String?
  producerId            String
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  producer       Producer              @relation(fields: [producerId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("CreatedEvents", fields: [createdById], references: [id])
  members        EventMember[]
  discountCode   DiscountCode[]
  orders         Order[]
  promotion      Promotion[]
  tickets        TicketOrder[]
  ticketTypes    TicketType[]
  validatorToken ValidatorToken[]
  eventPayments  EventPayment[]
  stockMovements TicketStockMovement[]
  featuredSlots  FeaturedEvent[]

  @@index([producerId])
  @@map("events")
}

model EventMember {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  role      EventRole @default(SELLER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_members")
}

// ─────────────────────────────────────────────
// TICKET TYPES
// ─────────────────────────────────────────────

model TicketType {
  id             String                @id @default(cuid())
  title          String
  description    String?
  date           DateTime?
  time           String?
  price          Decimal               @db.Decimal(10, 2)
  discount       Decimal?              @default(0) @db.Decimal(10, 2)
  limitPerSale   Int?                  @map("limit_per_sale")
  buyGet         Int?
  eventId        String
  createdById    String?
  status         TicketTypeStatus
  type           TicketTypes
  startDate      DateTime?             @default(now())
  endDate        DateTime?
  quantity       Int
  position       Int
  dates          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  isFree         Boolean               @default(false)
  discountCode   DiscountCode[]
  orders         Order[]
  promotion      Promotion[]
  ticketOrder    TicketOrder[]
  stockMovements TicketStockMovement[]
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("CreatedTicketTypes", fields: [createdById], references: [id])

  @@map("ticket_types")
}

model TicketStockMovement {
  id               String            @id @default(cuid())
  ticketTypeId     String
  eventId          String
  producerId       String
  performedById    String
  type             StockMovementType
  delta            Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  createdAt        DateTime          @default(now())

  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performedBy User       @relation("StockMovements", fields: [performedById], references: [id])

  @@index([ticketTypeId])
  @@index([eventId])
  @@index([producerId])
  @@map("ticket_stock_movements")
}

// ─────────────────────────────────────────────
// ORDERS & TICKETS
// ─────────────────────────────────────────────

model Order {
  id                  String         @id @default(cuid())
  name                String?
  lastName            String?
  dni                 String?
  email               String?
  phone               String?
  totalPrice          Decimal?       @db.Decimal(10, 2)
  subtotal            Decimal?       @db.Decimal(10, 2)
  discountAmount      Decimal?       @db.Decimal(10, 2)
  serviceChargeAmount Decimal?       @db.Decimal(10, 2)
  hasPromo            Boolean        @default(false)
  hasCode             Boolean        @default(false)
  discountCode        String?        @default("")
  status              OrderStatus
  ticketTypeId        String
  eventId             String
  quantity            Int
  isInvitation        Boolean        @default(false)
  customizationToken  String?        @unique
  customizedAt        DateTime?
  paymentMethodId     String?
  mpPaymentId         String?
  mpDateApproved      DateTime?
  mpPaymentMethodId   String?
  mpPaymentTypeId     String?
  mpInstallments      Int?
  mpAuthorizationCode String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  event               Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType          TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tickets             TicketOrder[]

  @@map("orders")
}

model TicketOrder {
  id           String            @id @default(cuid())
  name         String?
  lastName     String?
  dni          String?
  email        String?
  base64Qr     String?
  date         DateTime
  orderId      String
  eventId      String
  status       TicketOrderStatus
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  code         Int?              @default(autoincrement())
  ticketTypeId String?
  isInvitation Boolean           @default(false)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType?       @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@map("ticket_orders")
}

// ─────────────────────────────────────────────
// VALIDATORS & DISCOUNT CODES
// ─────────────────────────────────────────────

model ValidatorToken {
  id        String    @id @default(cuid())
  token     String    @unique
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endDate   DateTime?
  eventId   String
  useCount  Int       @default(0)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("validator_tokens")
}

model DiscountCode {
  id           String       @id @default(cuid())
  eventId      String?
  ticketTypeId String?
  code         String
  discount     Int?         @default(0)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  updatedAt    DateTime     @updatedAt
  status       GlobalStatus @default(ACTIVE)
  event        Event?       @relation(fields: [eventId], references: [id])
  ticketType   TicketType?  @relation(fields: [ticketTypeId], references: [id])

  @@map("discount_codes")
}

// ─────────────────────────────────────────────
// PROMOTIONS
// ─────────────────────────────────────────────

model Promotion {
  id           String          @id @default(cuid())
  title        String
  description  String?
  type         PromotionType
  discount     Decimal?        @db.Decimal(10, 2)
  limit        Int?
  startDate    DateTime
  endDate      DateTime
  eventId      String?
  ticketTypeId String?
  status       PromotionStatus
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  event        Event?          @relation(fields: [eventId], references: [id])
  ticketType   TicketType?     @relation(fields: [ticketTypeId], references: [id])

  @@map("promotions")
}

// ─────────────────────────────────────────────
// PAYMENT METHODS
// ─────────────────────────────────────────────

model PaymentMethod {
  id                   String      @id @default(cuid())
  type                 PaymentType
  name                 String?
  producerId           String
  userId               String? // Solo se usa si es CASH
  creatorId            String // Usuario que creó este método
  apiKey               String? // Solo para métodos tipo DIGITAL (ej: MP)
  cbu                  String? // CBU/CVU para transferencias
  alias                String? // Alias CBU para transferencias
  transferEmail        String? // Email para transferencias
  enabled              Boolean     @default(true)
  commissionPercentage Float? // Comisión del método de pago (ej: MercadoPago)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  producer Producer       @relation(fields: [producerId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator  User           @relation("CreatedPaymentMethods", fields: [creatorId], references: [id])
  events   EventPayment[]
  orders   Order[]

  @@map("payment_methods")
}

model EventPayment {
  id              String @id @default(cuid())
  eventId         String
  paymentMethodId String

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([eventId, paymentMethodId])
  @@map("event_payments")
}

// ─────────────────────────────────────────────
// FEATURED EVENTS (CAROUSEL)
// ─────────────────────────────────────────────

model FeaturedEvent {
  id          String              @id @default(cuid())
  eventId     String
  position    Int
  startDate   DateTime
  endDate     DateTime
  status      FeaturedEventStatus @default(ACTIVE)
  price       Decimal             @db.Decimal(10, 2)
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation("FeaturedEventCreatedBy", fields: [createdById], references: [id])

  @@index([eventId])
  @@index([startDate, endDate])
  @@map("featured_events")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  SELLER
}

enum EventRole {
  MANAGER
  SELLER
  VALIDATOR
  VIEWER
}

enum PaymentType {
  CASH
  DIGITAL
  TRANSFER
}

enum GlobalStatus {
  DRAFT
  ACTIVE
  CONCLUDED
  DELETED
  CANCELED
}

enum TicketTypes {
  NORMAL
  ABONO
  PROMO
  DESCUENTO
  COMPRA_X_OBTEN_Y
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
  ENDED
  DELETED
  SOLDOUT
}

enum OrderStatus {
  ACTIVE
  PAID
  PENDING
  EXPIRED
}

enum TicketOrderStatus {
  VALIDATED
  NOT_VALIDATED
}

enum PromotionType {
  DESCUENTO
  COMPRA_X_OBTEN_Y
}

enum PromotionStatus {
  ACTIVA
  INACTIVA
}

enum TicketPackageStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum TicketPackagePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  INCREASE
  DECREASE
}

enum EventCategory {
  MUSIC
  THEATER
  CONFERENCE
  SPORT
  ART
  GASTRONOMY
  COMEDY
  DANCE
  FESTIVAL
  CINEMA
  CORPORATE
  EXHIBITION
  NIGHTLIFE
  WORKSHOP
  OTHER
}

enum VenueType {
  BAR
  TEATRO
  SALON_DE_EVENTOS
  ANFITEATRO
  BOLICHE
  CENTRO_DE_CONVENCIONES
  ESTADIO
  CLUB_SOCIAL
  ESPACIO_CULTURAL
  OTRO
}

enum ProducerSource {
  WEBSITE
  SUPERADMIN
}

enum ProducerStatus {
  ACTIVE
  SUSPENDED
  IN_DEBT
  DELETED
}

enum EventType {
  PUBLIC
  PRIVATE
}

enum FeaturedEventStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}
